{
    "type": "layout",
    "version": "4.5.28",
    "name": "DONA Collection",
    "children": [
        {
            "type": "section",
            "props": {
                "class": "dona-collection-intro",
                "image_position": "center-center",
                "name": "Collection title",
                "padding": "small",
                "style": "default",
                "title_breakpoint": "xl",
                "title_position": "top-left",
                "title_rotation": "left",
                "vertical_align": "middle",
                "width": "expand"
            },
            "children": [
                {
                    "type": "row",
                    "props": {
                        "layout": "1-1"
                    },
                    "children": [
                        {
                            "type": "column",
                            "props": {
                                "image_position": "center-center",
                                "position_sticky_breakpoint": "m"
                            },
                            "children": [
                                {
                                    "type": "headline",
                                    "props": {
                                        "margin": "remove-vertical",
                                        "title_element": "h1",
                                        "title_style": "h2"
                                    },
                                    "source": {
                                        "query": {
                                            "name": "productCats",
                                            "field": {
                                                "name": "taxonomyProductCat"
                                            }
                                        },
                                        "props": {
                                            "content": {
                                                "name": "name"
                                            }
                                        }
                                    }
                                },
                                {
                                    "type": "text",
                                    "props": {
                                        "class": "dona-collection-description",
                                        "column_breakpoint": "m",
                                        "margin": "small",
                                        "maxwidth": "large"
                                    },
                                    "source": {
                                        "query": {
                                            "name": "productCats",
                                            "field": {
                                                "name": "taxonomyProductCat"
                                            }
                                        },
                                        "props": {
                                            "content": {
                                                "name": "description"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "section",
            "props": {
                "class": "dona-collection-catalog",
                "image_position": "center-center",
                "name": "Collection products",
                "padding": "small",
                "padding_remove_top": true,
                "style": "default",
                "title_breakpoint": "xl",
                "title_position": "top-left",
                "title_rotation": "left",
                "vertical_align": "middle",
                "width": "expand"
            },
            "children": [
                {
                    "type": "row",
                    "props": {
                        "layout": "1-1"
                    },
                    "children": [
                        {
                            "type": "column",
                            "props": {
                                "image_position": "center-center",
                                "position_sticky_breakpoint": "m"
                            },
                            "children": [
                                {
                                    "type": "woo_filter",
                                    "props": {
                                        "active_filters_align": "left",
                                        "class": "dona-shop-filter dona-collection-filter",
                                        "filter": "offcanvas",
                                        "filter_active_all": "both",
                                        "filter_active_display": true,
                                        "filter_dropdown_dropbar_content_width": "container",
                                        "filter_dropdown_grid": "4",
                                        "filter_dropdown_grid_breakpoint": "m",
                                        "filter_dropdown_parent_icon": true,
                                        "filter_dropnav_breakpoint": "m",
                                        "filter_dropnav_dropdown_align": "left",
                                        "filter_dropnav_fallback": "dropdown",
                                        "filter_offcanvas_flip": false,
                                        "filter_offcanvas_overlay": true,
                                        "filter_title_style": "h5",
                                        "filter_toggle_icon": "settings",
                                        "filter_toggle_icon_align": "left",
                                        "filter_toggle_style": "text",
                                        "filters_align": "left",
                                        "grid_breakpoint": "s",
                                        "grid_column_gap": "small",
                                        "grid_row_gap": "small",
                                        "margin": "remove-vertical",
                                        "name": "Left filter drawer",
                                        "product_ordering_align": "right",
                                        "product_ordering_icon_align": "left",
                                        "result_count_align": "right",
                                        "show_active_filters": true,
                                        "show_attribute_filters": true,
                                        "show_price_filter": false,
                                        "show_product_ordering": true,
                                        "show_rating_filter": false,
                                        "show_result_count": true
                                    }
                                },
                                {
                                    "type": "grid",
                                    "props": {
                                        "class": "dona-product-grid dona-collection-grid",
                                        "content_column_breakpoint": "m",
                                        "content_margin": "remove",
                                        "filter_align": "left",
                                        "filter_all": true,
                                        "filter_grid_breakpoint": "m",
                                        "filter_grid_width": "auto",
                                        "filter_position": "top",
                                        "filter_style": "tab",
                                        "grid_column_gap": "small",
                                        "grid_default": "2",
                                        "grid_medium": "4",
                                        "grid_row_gap": "small",
                                        "icon_width": 80,
                                        "image_align": "top",
                                        "image_grid_breakpoint": "m",
                                        "image_grid_width": "1-2",
                                        "image_svg_color": "emphasis",
                                        "item_animation": false,
                                        "lightbox_bg_close": true,
                                        "link_style": "default",
                                        "link_text": "",
                                        "margin": "small",
                                        "meta_align": "below-title",
                                        "meta_element": "div",
                                        "meta_style": "text-meta",
                                        "name": "Editorial image and collection products",
                                        "panel_link": true,
                                        "panel_link_hover": false,
                                        "show_content": true,
                                        "show_hover_image": true,
                                        "show_hover_video": true,
                                        "show_image": true,
                                        "show_link": true,
                                        "show_meta": true,
                                        "show_title": true,
                                        "show_video": true,
                                        "title_align": "top",
                                        "title_element": "h2",
                                        "title_grid_breakpoint": "m",
                                        "title_grid_width": "1-2",
                                        "title_hover_style": "reset",
                                        "title_margin": "remove"
                                    },
                                    "children": [
                                        {
                                            "type": "grid_item",
                                            "source": {
                                                "query": {
                                                    "name": "productCats",
                                                    "field": {
                                                        "name": "taxonomyProductCat"
                                                    }
                                                },
                                                "props": {
                                                    "image": {
                                                        "name": "donaCollectionImage.url"
                                                    },
                                                    "image_alt": {
                                                        "name": "name"
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "type": "grid_item",
                                            "source": {
                                                "query": {
                                                    "name": "productCats",
                                                    "field": {
                                                        "name": "productCatProduct"
                                                    }
                                                },
                                                "props": {
                                                    "title": {
                                                        "name": "title"
                                                    },
                                                    "content": {
                                                        "name": "woocommerce.price"
                                                    },
                                                    "image": {
                                                        "name": "featuredImage.url"
                                                    },
                                                    "image_alt": {
                                                        "name": "featuredImage.alt"
                                                    },
                                                    "hover_image": {
                                                        "name": "donaShopHoverImage.url"
                                                    },
                                                    "hover_video": {
                                                        "name": "donaShopHoverVideo"
                                                    },
                                                    "meta": {
                                                        "name": "donaBadge"
                                                    },
                                                    "link": {
                                                        "name": "link"
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "pagination",
                                    "props": {
                                        "margin": "medium",
                                        "pagination_type": "previous/next",
                                        "text_align": "center"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}