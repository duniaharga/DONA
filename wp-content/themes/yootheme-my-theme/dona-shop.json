                                        "panel_link_hover": false,
                                        "show_content": false,
                                        "show_hover_image": true,
                                        "show_hover_video": true,
                                        "show_image": true,
                                        "show_link": true,
                                        "show_meta": false,
                                        "show_title": true,
                                        "show_video": true,
