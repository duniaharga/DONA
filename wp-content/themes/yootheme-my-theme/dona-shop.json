{
    "type": "layout",
    "version": "4.5.28",
    "name": "DONA Shop",
    "children": [
        {
            "type": "section",
            "props": {
                "class": "dona-shop-intro",
                "image_position": "center-center",
                "name": "Shop collections",
                "padding": "small",
                "style": "default",
                "title_breakpoint": "xl",
                "title_position": "top-left",
                "title_rotation": "left",
                "vertical_align": "middle",
                "width": "expand"
            },
            "children": [
                {
                    "type": "row",
                    "props": {
                        "layout": "1-1"
                    },
                    "children": [
                        {
                            "type": "column",
                            "props": {
                                "image_position": "center-center",
                                "position_sticky_breakpoint": "m"
                            },
                            "children": [
                                {
                                    "type": "headline",
                                    "props": {
                                        "content": "Bags",
                                        "margin": "remove-vertical",
                                        "title_element": "h1",
                                        "title_style": "h1"
                                    }
                                },
                                {
                                    "type": "text",
                                    "props": {
                                        "column_breakpoint": "m",
                                        "content": "Discover DONA collections: thoughtful shapes, everyday function, and understated elegance.",
                                        "margin": "medium",
                                        "maxwidth": "large"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "section",
            "props": {
                "image_position": "center-center",
                "padding": "xsmall",
                "style": "default",
                "title_breakpoint": "xl",
                "title_position": "top-left",
                "title_rotation": "left",
                "vertical_align": "middle",
                "width": ""
            },
            "children": [
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "column",
                            "props": {
                                "image_position": "center-center",
                                "position_sticky_breakpoint": "m"
                            },
                            "children": [
                                {
                                    "type": "grid",
                                    "props": {
                                        "class": "dona-shop-collections",
                                        "content_column_breakpoint": "m",
                                        "filter_align": "left",
                                        "filter_all": true,
                                        "filter_grid_breakpoint": "m",
                                        "filter_grid_width": "auto",
                                        "filter_position": "top",
                                        "filter_style": "tab",
                                        "grid_column_gap": "small",
                                        "grid_default": "2",
                                        "grid_large": "3",
                                        "grid_medium": "3",
                                        "grid_row_gap": "medium",
                                        "grid_small": "3",
                                        "icon_width": 80,
                                        "id": "collections",
                                        "image_align": "top",
                                        "image_grid_breakpoint": "m",
                                        "image_grid_width": "1-2",
                                        "image_height": 600,
                                        "image_svg_color": "emphasis",
                                        "image_width": 500,
                                        "item_animation": true,
                                        "lightbox_bg_close": true,
                                        "link_style": "default",
                                        "link_text": "",
                                        "margin": "large",
                                        "meta_align": "below-title",
                                        "meta_element": "div",
                                        "meta_style": "text-meta",
