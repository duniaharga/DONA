# Source-only repository: WordPress runtime, database and private context stay local.
/*
!/.gitignore
!/README.md
!/wp-content/
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/yootheme-my-theme/
/wp-content/themes/yootheme-my-theme/*
!/wp-content/themes/yootheme-my-theme/functions.php
!/wp-content/themes/yootheme-my-theme/style.css
!/wp-content/themes/yootheme-my-theme/dona-*.json
!/wp-content/themes/yootheme-my-theme/inc/
!/wp-content/themes/yootheme-my-theme/js/
!/wp-content/themes/yootheme-my-theme/css/
!/wp-content/themes/yootheme-my-theme/less/
!/wp-content/themes/yootheme-my-theme/assets/
/wp-content/themes/yootheme-my-theme/css/theme*.css
/wp-content/themes/yootheme-my-theme/less/*
!/wp-content/themes/yootheme-my-theme/less/*.less
/wp-content/themes/yootheme-my-theme/assets/*
!/wp-content/themes/yootheme-my-theme/assets/header/
!/wp-content/themes/yootheme-my-theme/assets/fonts/
!/wp-content/themes/yootheme-my-theme/assets/editorial/
!/wp-content/themes/yootheme-my-theme/assets/hero/
!/wp-content/themes/yootheme-my-theme/assets/products/
!/wp-content/themes/yootheme-my-theme/assets/collections/
/wp-content/themes/yootheme-my-theme/assets/products/*.json
/wp-content/themes/yootheme-my-theme/assets/products/*.md
**/.DS_Store
**/*.bak
**/*.log
**/*.sql
**/*.sqlite*
**/.env*
**/node_modules/

!/skills/
